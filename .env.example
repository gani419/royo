# ==========================================
# ROYO MONOREPO ROOT ENVIRONMENT TEMPLATE
# ==========================================

# Public Application URLs
PUBLIC_APP_URL=https://royo.tecdroid.com
PUBLIC_API_BASE_URL=https://royo.tecdroid.com

# Backend Configuration (backend/.env)
APP_ENV=development
PORT=8080
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/royo?sslmode=require

# Security Keys
JWT_SECRET=your_jwt_secret_min_32_characters_long
JWT_REFRESH_SECRET=your_refresh_secret_min_32_characters_long

# AI & External Provider Keys (Server-side ONLY)
GEMINI_API_KEY=your_gemini_server_side_key
OPENAI_API_KEY=your_openai_backup_server_side_key
YOUTUBE_API_KEY=your_youtube_data_api_v3_key

