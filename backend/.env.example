# ROYO Go Backend Environment Configuration
APP_ENV=development
PORT=8080

# Remote PostgreSQL Managed Database URL (Must have sslmode=require or sslmode=verify-full)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/royo?sslmode=require

# JWT Auth Secret Keys
JWT_SECRET=replace_with_secure_random_32_character_secret
JWT_REFRESH_SECRET=replace_with_another_secure_random_32_character_secret

# AI Providers
GEMINI_API_KEY=your_gemini_server_api_key
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=your_openai_backup_api_key

# YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key

# CORS Allowed Origins (Comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://royo.tecdroid.com

